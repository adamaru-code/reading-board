# ルート用 .gitignore（backend/ と frontend/ は各自の .gitignore も持つ）

# OS / エディタ
.DS_Store
*.swp
.idea/
# VS Code の個人設定は除外し、おすすめ拡張機能のリスト（extensions.json）だけ共有する
.vscode/*
!.vscode/extensions.json

# 環境変数・秘密情報
# mise の個人用設定（GOOGLE_BOOKS_API_KEY などの鍵を置く。backend/mise.local.toml）
mise.local.toml
.mise.local.toml
.env
.env.*
!.env.example

# ログ・一時ファイル
*.log
tmp/

# Bundler のローカル設定（マシン固有。mysql2 のビルドパス等）
backend/.bundle/

# 将来 infra/(Terraform) を追加した時用
**/.terraform/
*.tfstate
*.tfstate.*
**/terraform.tfvars
# plan -out の出力（シークレットを含む）
**/tfplan
*.tfplan
*.tfplan
