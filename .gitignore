# ルート用 .gitignore（backend/ と frontend/ は各自の .gitignore も持つ）

# OS / エディタ
.DS_Store
*.swp
.idea/
.vscode/

# 環境変数・秘密情報
.env
.env.*
!.env.example

# ログ・一時ファイル
*.log
tmp/

# Bundler のローカル設定（マシン固有。mysql2 のビルドパス等）
backend/.bundle/

# 将来 infra/(Terraform) を追加した時用
**/.terraform/
*.tfstate
*.tfstate.*
**/terraform.tfvars
# plan -out の出力（シークレットを含む）
**/tfplan
*.tfplan
*.tfplan
