{
  // VS Code でこのリポジトリを開くと、右下に下の拡張機能のインストールが案内される（入れるかは各自で選べる）。
  // 選び方：日本語の記事で定番として挙がる × その道具の公式・利用者の多いもの
  "recommendations": [
    // .tf（Terraform）の色分け・整形（HashiCorp 公式）
    "hashicorp.terraform",
    // .vue の色分け・型チェック（Vue 公式。旧 Vetur の後継）
    "Vue.volar",
    // .rb（Ruby / Rails）の色分け・補完
    "Shopify.ruby-lsp",
    // npm run lint と同じチェックをエディタ上に表示
    "dbaeumer.vscode-eslint",
    // npm run format と同じ整形
    "esbenp.prettier-vscode",
    // VS Code のメニューを日本語にする
    "MS-CEINTL.vscode-language-pack-ja"
  ]
}
